{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!public", "!**/*.md", "!!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "a11y": {
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useIframeTitle": "warn",
        "useKeyWithClickEvents": "warn"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "warn",
        "noComponentHookFactories": "warn",
        "noInnerDeclarations": "warn",
        "noNextAsyncClientComponent": "warn",
        "noUnreachable": "warn",
        "useExhaustiveDependencies": "warn",
        "useInlineScriptId": "error"
      },
      "performance": {
        "noImgElement": "warn",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "style": {
        "noHeadElement": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noDocumentImportInPage": "error",
        "noDoubleEquals": "warn",
        "noHeadImportInDocument": "error",
        "noImplicitAnyLet": "warn",
        "noRedeclare": "warn",
        "useGoogleFontDisplay": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  }
}
